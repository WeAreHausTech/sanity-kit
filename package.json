{
  "name": "@webicient/sanity-kit",
  "version": "0.3.7",
  "description": "This plugin provides curated list of pre-built features for the Sanity CMS. It was designed to cater +75% of all the needed tools in development and marketing to any of Webicient projects.",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/webicient/sanity-kit#readme",
  "bugs": {
    "url": "https://github.com/webicient/sanity-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gith ub.com/webicient/sanity.git"
  },
  "license": "MIT",
  "author": "Webicient <dev@webicient.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "source": "./src/env/index.ts",
      "import": "./dist/env/index.js",
      "default": "./dist/env/index.js"
    },
    "./utils": {
      "source": "./src/utils/index.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./query": {
      "source": "./src/query/index.ts",
      "import": "./dist/query/index.js",
      "default": "./dist/query/index.js"
    },
    "./provider": {
      "source": "./src/provider/index.ts",
      "import": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./resolvers": {
      "source": "./src/resolvers/index.ts",
      "import": "./dist/resolvers/index.js",
      "default": "./dist/resolvers/index.js"
    },
    "./visual-editing": {
      "source": "./src/visual-editing/index.ts",
      "import": "./dist/visual-editing/index.js",
      "default": "./dist/visual-editing/index.js"
    },
    "./queries": {
      "source": "./src/queries/index.ts",
      "import": "./dist/queries/index.js",
      "default": "./dist/queries/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "dev": "plugin-kit link-watch",
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict",
    "test": "vitest"
  },
  "dependencies": {
    "@next/third-parties": "14.2.5",
    "@opentelemetry/api": "1.9.0",
    "@portabletext/types": "2.0.13",
    "@sanity/asset-utils": "1.3.0",
    "@sanity/client": "6.21.1",
    "@sanity/icons": "3.3.1",
    "@sanity/image-url": "1.0.2",
    "@sanity/incompatible-plugin": "1.0.4",
    "@sanity/language-filter": "4.0.2",
    "@sanity/react-loader": "1.10.4",
    "@sanity/vision": "3.52.4",
    "cookies-next": "4.2.1",
    "deepmerge": "4.3.1",
    "groq": "3.52.4",
    "lodash": "4.17.21",
    "react-error-boundary": "4.0.13",
    "rollup-preserve-directives": "1.1.1",
    "sanity-plugin-media": "2.3.2",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "6.10.8",
    "@sanity/plugin-kit": "4.0.18",
    "@types/lodash": "4.17.7",
    "@types/react": "18.3.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vercel/style-guide": "6.0.0",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-sanity": "7.1.2",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.3.3",
    "prettier-plugin-packagejson": "2.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanity": "3.52.4",
    "styled-components": "6.1.12",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "peerDependencies": {
    "next": "14.2.8",
    "next-intl": "3.17.5",
    "next-sanity": "9.4.3",
    "react": "18.3.1",
    "sanity": "3.52.4"
  },
  "engines": {
    "node": ">=18"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "eslintImports": false,
      "studioConfig": false,
      "scripts": false,
      "dependencies": false
    }
  },
  "browserslist": [
    "extends @sanity/browserslist-config"
  ],
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53"
}
